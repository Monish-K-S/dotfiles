{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",
  "model": "larprouter/deepseek-v4.1-flash",

  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow"
    }
  },

  "provider": {
    "aicredits": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AICredits",
      "options": {
        "baseURL": "https://api.aicredits.in/v1"
      },
      "models": {
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5"
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash"
        },
        "qwen/qwen3.7-flash": {
          "name": "Qwen 3.7 Flash"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS-120B"
        },
        "minimax/minimax-m3": {
          "name": "MiniMax M3"
        },
        "deepseek/deepseek-v3.2": {
          "name": "DeepSeek V3.2"
        },
        "meta/muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor"
        }
      }
    },

    "tokenharbor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Harbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1"
      },
      "models": {
        "mimo-v2.6-flash:free": {
          "name": "MiMo V2.6 Flash Free"
        },
        "qwen3.8-flash:free": {
          "name": "Qwen3.8 Flash Free"
        },
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash Free"
        }
      }
    },

    "larprouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LarpRouter",
      "options": {
        "baseURL": "https://larprouter.com/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    },

    "zenmux": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ZenMux",
      "options": {
        "baseURL": "https://zenmux.ai/api/v1"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017"
        },
        "minimax/minimax-m3.1-flash": {
          "name": "MiniMax M3.1 Flash Active"
        }
      }
    },

    "OxionAI": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Oxion AI",
      "options": {
        "baseURL": "https://www.oxionai.com/v1",
        "apiKey": "{env:OXIONAI_API_KEY}"
      },
      "models": {
        "claude-opus-5.5": {
          "name": "Claude Opus 5.5"
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B"
        },
        "deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        },
        "gemma-2-2b": {
          "name": "Gemma 2 2B"
        }
      }
    }
  }
}
