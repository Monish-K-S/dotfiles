{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium",
    "markdown": "rendered",
    "permissions": "prompt"
  },
  "animations": false,
  "tabs": {
    "mode": "auto",
    "indicators": "numbers"
  },
  "scroll": {
    "speed": 2.75
  }
}
